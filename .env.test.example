# Test configuration. Copy to .env.test (git-ignored) and fill in.
# `npm test` loads ONLY this file — never .env — and tests/db-guard.mjs aborts
# unless the database below is explicitly a local *_test database distinct
# from the development database in .env.
#
# One-time setup (MySQL):
#   CREATE DATABASE clearcollect_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'clearcollect_test'@'localhost' IDENTIFIED BY '<password>';
#   GRANT ALL PRIVILEGES ON clearcollect_test.* TO 'clearcollect_test'@'localhost';
# This user can reach only the test database, so even a misconfigured run
# cannot read or write the development database.
# Then:
#   npm run test:db:setup     # apply migrations to the test database
#   npm test
#   npm run test:db:reset     # optional: wipe leftovers after an interrupted run

# Must be a mysql:// URL on localhost whose database name ends in _test.
TEST_DATABASE_URL="mysql://clearcollect_test:<password>@localhost:3306/clearcollect_test"
# Must repeat the database name exactly — confirms it is a test database.
CLEARCOLLECT_TEST_DATABASE=clearcollect_test

# Do NOT set DATABASE_URL here; the guard sets it from TEST_DATABASE_URL.

# PayPal Sandbox app credentials — only Sandbox is allowed. Needed by
# tests/paypal-webhook.test.ts (signature verification against Sandbox);
# other Sandbox-backed tests skip without them. Never live credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"
# Optional: a Sandbox webhook ID. Unset → an unregistered placeholder is used,
# which PayPal rejects (what the invalid-signature tests expect).
# PAYPAL_WEBHOOK_ID=

# No Zapier or Gemini settings: tests supply their own fakes.
