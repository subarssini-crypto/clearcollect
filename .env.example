# Copy to .env and fill in real values. Never commit .env.

# Single-owner sign-in (required — every page and API route except the PayPal
# callbacks needs it). Generate both with: npm run auth:setup (writes them into .env)
# AUTH_SECRET: 32+ random characters that encrypt the session cookie.
# OWNER_PASSWORD_HASH: scrypt hash of the owner password (never the password itself).
AUTH_SECRET="generate-with-npm-run-auth-setup"
OWNER_PASSWORD_HASH="generate-with-npm-run-auth-setup"

# MySQL connection string
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/clearcollect"

# PayPal Sandbox REST app credentials (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID="your-sandbox-client-id"
PAYPAL_CLIENT_SECRET="your-sandbox-client-secret"
# Any URL containing "sandbox" (or unset) uses PayPal Sandbox
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"
# Webhook ID from your Sandbox app's Webhooks section (required for /api/paypal/webhook)
PAYPAL_WEBHOOK_ID="your-sandbox-webhook-id"

# Public base URL for PayPal return/cancel links. Optional on localhost; required for
# tunnels (ngrok) and deployments, otherwise payment creation is refused.
# APP_URL="http://localhost:3000"

# Google Gemini API key for the AI invoice generator (aistudio.google.com → Get API key)
GEMINI_API_KEY="your-gemini-api-key"

# Zapier delivery for approved follow-up reminders (optional — demo mode when both are unset).
# URL from a Zapier "Webhooks by Zapier → Catch Hook" trigger. Keep it private.
ZAPIER_WEBHOOK_URL="https://hooks.zapier.com/hooks/catch/your-id/your-hook/"
# Shared secret (16+ chars) sent with each reminder; your Zap's Filter step must check it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ZAPIER_WEBHOOK_SECRET="your-long-random-secret"

# Zapier delivery for invoice emails (optional — demo mode when unset). URL from a
# separate "Catch Hook" Zap; it reuses ZAPIER_WEBHOOK_SECRET for its Filter step.
ZAPIER_INVOICE_WEBHOOK_URL="https://hooks.zapier.com/hooks/catch/your-id/your-invoice-hook/"
