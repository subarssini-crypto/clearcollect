# Copy to .env and fill in real values. Never commit .env.

# MySQL connection string
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/clearcollect"

# PayPal Sandbox REST app credentials (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID="your-sandbox-client-id"
PAYPAL_CLIENT_SECRET="your-sandbox-client-secret"
# Any URL containing "sandbox" (or unset) uses PayPal Sandbox
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"
# Webhook ID from your Sandbox app's Webhooks section (required for /api/paypal/webhook)
PAYPAL_WEBHOOK_ID="your-sandbox-webhook-id"

# Optional: public base URL for PayPal return/cancel links (defaults to request origin)
# APP_URL="http://localhost:3000"

# Google Gemini API key for the AI invoice generator (aistudio.google.com → Get API key)
GEMINI_API_KEY="your-gemini-api-key"
